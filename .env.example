# ==============================================================================
# Resilient Multi-Agent Energy Management System (Resilient-MAS) Environment
# ==============================================================================

# LLM Provider Configuration ("gemini", "openai", "mock")
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Simulation Settings
SIMULATION_STEPS=168
RANDOM_SEED=42
LOG_LEVEL=INFO

# Paths (defaults are relative to project root)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
CONFIG_DIR=config
